  "cloneParents": [
    {
      "id": "orbitclean",
      "name": "Orbit Clean",
      "feature": ":features:cleaner",
      "summary": "文件管理 + 存储清理（冗余、重复、大文件），SAF 文件夹授权，无存储权限",
      "variants": {
        "scene": "saturn",
        "nav": "tabs",
        "home": "dashboard",
        "clean": "stepwise",
        "browser": "list",
        "done": "summary"
      },
      "_note": "母包自己的组合（土星场景、底部标签、仪表盘式清理页、分步清理、列表文件页、汇总完成页）；复刻包至少要在 minDiffAxes 个轴上和它不同，场景永远不能是 saturn"
    }
  ],
  "cloneMinDiffAxes": 3,
  "cloneVariants": {
    "scene": [
      {
        "id": "ring",
        "name": "环形进度",
        "summary": "刻度环 + 渐变进度环 + 环头光点：扫描时彗星光弧绕圈点亮刻度，清理时整环加速、内盘脉动，完成时环身闪动；带粒子层"
      },
      {
        "id": "particles",
        "name": "粒子云",
        "summary": "呼吸的光核 + 密集粒子云：扫描时雷达扇面转动、光点汇聚，清理时光核收缩、光点螺旋坠入，完成时膨胀迸发"
      },
      {
        "id": "stack",
        "name": "分层柱",
        "summary": "一排竖条像存储刻度：扫描时均衡器般跳动、亮带扫过，清理时依次塌下，完成时带回弹长回并迸发光点"
      }
    ],
    "nav": [
      {
        "id": "tabs",
        "name": "底部三标签",
        "summary": "清理 / 文件 / 设置三个底部标签"
      },
      {
        "id": "hub",
        "name": "单页入口",
        "summary": "没有底部导航，首页就是全部入口，右上角设置，其余页面压栈进入"
      }
    ],
    "home": [
      {
        "id": "dashboard",
        "name": "仪表盘",
        "summary": "大场景 + 扫描主按钮，下面是清理工具列表、按类型横滑、更多入口"
      },
      {
        "id": "grid",
        "name": "宫格",
        "summary": "顶部紧凑用量卡（小场景 + 扫描按钮），下面两列宫格放全部入口"
      }
    ],
    "clean": [
      {
        "id": "stepwise",
        "name": "分步清理",
        "summary": "扫描出三类结果，逐类进入勾选再删除；扫描结果出来弹一次插屏"
      },
      {
        "id": "onetap",
        "name": "一键清理",
        "summary": "扫描后按类整块勾选，一个按钮清理全部；只在清理完成后弹插屏"
      }
    ],
    "browser": [
      {
        "id": "list",
        "name": "列表",
        "summary": "文件一行一个，左边缩略图"
      },
      {
        "id": "grid",
        "name": "网格",
        "summary": "三列网格，大缩略图"
      }
    ],
    "done": [
      {
        "id": "summary",
        "name": "汇总",
        "summary": "大场景 + 释放空间大数字 + 前后用量对比 + 推荐卡片"
      },
      {
        "id": "checklist",
        "name": "清单",
        "summary": "小场景标题 + 逐条打勾的结果清单 + 紧凑推荐列表"
      }
    ]
  }
}